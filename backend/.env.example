APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/keep_rollin
DATABASE_ROLE=keep_rollin_app
DATABASE_TIMEOUT_SECONDS=2.0
PLATFORM_DOMAIN=platform.test
ALLOW_TENANT_HEADER=true
# Set a unique value of at least 32 characters in production.
# JWT_SECRET=
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PASSWORD_WORK_TIMEOUT_SECONDS=5.0
REFRESH_COOKIE_NAME=__Host-rt
REFRESH_COOKIE_SECURE=true
# base64url-encoded 32-byte key for MFA/VAPID secret encryption.
# Required in production; generate with:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# SECURITY_KEY=
SECURITY_KEY_ID=primary
# JSON object of previous key id -> base64url key for rotation, e.g.
# SECURITY_PREVIOUS_KEYS={"old":"..."}
# Previous keys decrypt old TOTP/VAPID ciphertext. Recovery codes are hashed
# with the active key only; after rotation users must re-enroll or receive new
# recovery codes.
PASSWORD_RESET_TTL_SECONDS=3600
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_EMAIL_PER_MINUTE=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_RETENTION_DAYS=365
# Privileged DSN for `python -m app.cli provision-tenant` and `purge-audit-log`.
# Must not be the API role; use a dedicated owner/BYPASSRLS role with narrow grants.
# PROVISION_DATABASE_URL=
# Use distinct S3 buckets and grant public reads only to the public bucket.
# Credentials use the AWS SDK chain (workload role, AWS profile or AWS_* credentials).
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_PUBLIC_BUCKET=keep-rollin-public
# S3_PRIVATE_BUCKET=keep-rollin-private
# Base URL serving the root of S3_PUBLIC_BUCKET, optionally through a CDN.
# S3_PUBLIC_BASE_URL=https://images.example.com
# S3_PRESIGN_TTL_SECONDS=300
# Optional email dispatch in the worker. Set host and sender together.
# WORKER_SMTP_HOST=
# WORKER_SMTP_FROM_ADDRESS=notifications@example.com
# WORKER_SMTP_PORT=587
# WORKER_SMTP_SECURITY=starttls
# WORKER_SMTP_TIMEOUT_SECONDS=5
# WORKER_SMTP_USERNAME=
# WORKER_SMTP_PASSWORD=

# Optional Web Push and channel routing. Use the same SECURITY_KEY ring as tenant provisioning.
# WORKER_PUSH_ENABLED=false
# WORKER_PUSH_SUBJECT=mailto:notifications@example.com
# WORKER_PUSH_TIMEOUT_SECONDS=5
