{
  "openapi": "3.1.0",
  "info": {
    "title": "Keep Rollin API",
    "version": "1.0.0-seed",
    "description": "Seed-подмножество контракта (§4 плана): публичный каталог, авторизация, аренды. Источник правды переезжает в Pydantic на CT-03."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "public", "description": "Доступно без токена" },
    { "name": "auth", "description": "Аутентификация" },
    { "name": "rentals", "description": "Брони и аренды" }
  ],
  "paths": {
    "/api/v1/public/tenant": {
      "get": {
        "operationId": "getTenant",
        "tags": ["public"],
        "summary": "Брендинг и политики тенанта",
        "responses": {
          "200": {
            "description": "Тенант",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tenant" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/public/categories": {
      "get": {
        "operationId": "listCategories",
        "tags": ["public"],
        "summary": "Активные категории с характеристиками",
        "responses": {
          "200": {
            "description": "Категории",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } }
            }
          }
        }
      }
    },
    "/api/v1/public/lots": {
      "get": {
        "operationId": "listLots",
        "tags": ["public"],
        "summary": "Каталог активных лотов",
        "parameters": [
          { "name": "category_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Страница лотов",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LotPage" } } }
          },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/v1/public/lots/{slug}": {
      "get": {
        "operationId": "getLot",
        "tags": ["public"],
        "summary": "Карточка лота",
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Лот",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lot" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/public/lots/{slug}/availability": {
      "get": {
        "operationId": "getLotAvailability",
        "tags": ["public"],
        "summary": "Занятость лота в интервале",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Занятость",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Availability" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Вход по email и паролю",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Сессия",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "tags": ["auth"],
        "summary": "Текущая сессия и права",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Сессия",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/me/rentals": {
      "get": {
        "operationId": "listMyRentals",
        "tags": ["rentals"],
        "summary": "Мои аренды",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["booked", "active", "overdue", "completed", "cancelled"]
            }
          },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Страница аренд",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RentalPage" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/rentals": {
      "post": {
        "operationId": "createRental",
        "tags": ["rentals"],
        "summary": "Создать бронь",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRentalRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Бронь создана",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rental" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/v1/me/rentals/{id}/cancel": {
      "post": {
        "operationId": "cancelRental",
        "tags": ["rentals"],
        "summary": "Отменить бронь",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Бронь отменена",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rental" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "Unauthorized": {
        "description": "Не авторизован",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Forbidden": {
        "description": "Нет прав",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "Не найдено",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Conflict": {
        "description": "Конфликт состояния",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Validation": {
        "description": "Ошибка валидации",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string", "examples": ["urn:keeprollin:error:slot_taken"] },
          "title": { "type": "string", "examples": ["Слот занят"] },
          "status": { "type": "integer", "examples": [409] },
          "code": { "type": "string", "examples": ["slot_taken"] },
          "detail": { "type": "string", "examples": ["Лот занят в выбранном интервале"] },
          "trace_id": { "type": "string" },
          "fields": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "Tenant": {
        "type": "object",
        "required": ["id", "name", "slug", "timezone", "currency", "primary_color", "policies"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "examples": ["Северный Ветер"] },
          "slug": { "type": "string", "examples": ["severny-veter"] },
          "logo_url": { "type": ["string", "null"] },
          "primary_color": { "type": "string", "examples": ["#0f766e"] },
          "timezone": { "type": "string", "examples": ["Europe/Moscow"] },
          "currency": { "type": "string", "examples": ["RUB"] },
          "vapid_public_key": { "type": ["string", "null"] },
          "policies": { "$ref": "#/components/schemas/TenantPolicies" }
        }
      },
      "TenantPolicies": {
        "type": "object",
        "required": [
          "booking_horizon_days",
          "min_rental_minutes",
          "max_rental_days",
          "cancellation_free_hours",
          "reminder_hours_before",
          "tickets_per_rental_per_day"
        ],
        "properties": {
          "booking_horizon_days": { "type": "integer", "examples": [60] },
          "min_rental_minutes": { "type": "integer", "examples": [60] },
          "max_rental_days": { "type": "integer", "examples": [30] },
          "cancellation_free_hours": { "type": "integer", "examples": [24] },
          "reminder_hours_before": { "type": "integer", "examples": [1] },
          "tickets_per_rental_per_day": { "type": "integer", "examples": [5] }
        }
      },
      "Characteristic": {
        "type": "object",
        "required": ["id", "code", "name", "type", "is_required", "options", "sort"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "examples": ["power"] },
          "name": { "type": "string", "examples": ["Мощность"] },
          "type": { "type": "string", "enum": ["number", "text", "select"] },
          "unit": { "type": ["string", "null"], "examples": ["Вт"] },
          "is_required": { "type": "boolean" },
          "options": { "type": "array", "items": { "type": "string" } },
          "sort": { "type": "integer" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "name", "slug", "is_archived", "characteristics"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "examples": ["Электробайки"] },
          "slug": { "type": "string", "examples": ["ebikes"] },
          "description": { "type": ["string", "null"] },
          "is_archived": { "type": "boolean" },
          "characteristics": { "type": "array", "items": { "$ref": "#/components/schemas/Characteristic" } }
        }
      },
      "Lot": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "category_id",
          "photos",
          "characteristics",
          "rental_model",
          "price_minor",
          "currency",
          "status",
          "is_bookable"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string", "examples": ["urban-1"] },
          "name": { "type": "string", "examples": ["Urban 1"] },
          "description": { "type": "string" },
          "category_id": { "type": "string", "format": "uuid" },
          "photos": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "characteristics": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
          "rental_model": { "type": "string", "enum": ["hourly", "daily", "custom"] },
          "price_minor": { "type": "integer", "minimum": 1, "examples": [45000] },
          "currency": { "type": "string", "examples": ["RUB"] },
          "status": { "type": "string", "enum": ["active", "archived", "maintenance", "overdue"] },
          "is_bookable": { "type": "boolean" }
        }
      },
      "LotPage": {
        "type": "object",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Lot" } },
          "total": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "BusyInterval": {
        "type": "object",
        "required": ["start", "end", "kind"],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "kind": { "type": "string", "enum": ["busy", "booking", "block", "maintenance"] }
        }
      },
      "FreeWindow": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      },
      "Availability": {
        "type": "object",
        "required": ["lot_id", "from", "to", "busy"],
        "properties": {
          "lot_id": { "type": "string", "format": "uuid" },
          "from": { "type": "string", "format": "date-time" },
          "to": { "type": "string", "format": "date-time" },
          "busy": { "type": "array", "items": { "$ref": "#/components/schemas/BusyInterval" } },
          "next_free": { "anyOf": [{ "$ref": "#/components/schemas/FreeWindow" }, { "type": "null" }] }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name", "role", "verification_status"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email", "examples": ["rider@example.com"] },
          "name": { "type": "string", "examples": ["Иван Петров"] },
          "role": { "type": "string", "enum": ["owner", "admin", "user"] },
          "verification_status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      },
      "Session": {
        "type": "object",
        "required": ["user", "role", "permissions", "offer_accepted"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "role": { "type": "string", "enum": ["owner", "admin", "user"] },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "offer_accepted": { "type": "boolean" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["access_token", "expires_in", "user", "role", "permissions"],
        "properties": {
          "access_token": { "type": "string" },
          "expires_in": { "type": "integer", "examples": [900] },
          "user": { "$ref": "#/components/schemas/User" },
          "role": { "type": "string", "enum": ["owner", "admin", "user"] },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "RentalLot": {
        "type": "object",
        "required": ["id", "slug", "name", "photo_url"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "photo_url": { "type": ["string", "null"], "format": "uri" }
        }
      },
      "Rental": {
        "type": "object",
        "required": [
          "id",
          "lot",
          "status",
          "start_time",
          "end_time",
          "price_minor",
          "currency",
          "remaining_seconds"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "lot": { "$ref": "#/components/schemas/RentalLot" },
          "status": { "type": "string", "enum": ["booked", "active", "overdue", "completed", "cancelled"] },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "price_minor": { "type": "integer" },
          "currency": { "type": "string" },
          "remaining_seconds": { "type": "integer" },
          "cancellation_deadline": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "RentalPage": {
        "type": "object",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Rental" } },
          "total": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "CreateRentalRequest": {
        "type": "object",
        "required": ["lot_id", "start_time", "end_time"],
        "properties": {
          "lot_id": { "type": "string", "format": "uuid" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
