# Copy to deploy/deploy.env and adjust. Sourced by deploy/deploy.sh.
IMAGE_REPO=ghcr.io/andrewganzha/keep-rollin-frontend
# registry  — push to a registry, k3s pulls it
# ssh-import — pipe the image into `sudo k3s ctr images import` over SSH (no registry)
IMAGE_TRANSPORT=registry
PLATFORM=linux/amd64
KUBE_CONTEXT=
INGRESS_HOST=
SMOKE_PORT=18080
# Only for IMAGE_TRANSPORT=ssh-import:
K3S_SSH_TARGET=
K3S_SSH_KEY=
K3S_SSH_KNOWN_HOSTS=
